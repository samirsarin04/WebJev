# Copy to .env and fill in. Empty values are ignored.

# Jev (TypeSafe). Required for Jev mode; without it only --offline (mock Jev) and baseline mode work.
TYPESAFE_API_KEY=
# Pin a version (e.g. jev-1.13.0) once thresholds are tuned; jev-latest moves with releases.
TYPESAFE_DEFAULT_MODEL=jev-latest

# LLM that writes queries, summaries and answers (and makes the decisions in baseline mode).
# OpenAI is used when OPENAI_API_KEY is set. (ANTHROPIC_API_KEY also works; force one with
# WEBJEV_LLM_PROVIDER=openai|anthropic.)
OPENAI_API_KEY=
# Leave empty for the default (gpt-5.6-sol). Set it if your account uses a different model.
WEBJEV_LLM_MODEL=

# Search. Set one key: Serper (Google results, serper.dev) or Tavily (tavily.com). Serper wins if both
# are set. Without a key the agent tries DuckDuckGo scraping, which is often blocked.
SERPER_API_KEY=
TAVILY_API_KEY=

# Optional tuning
# WEBJEV_MAX_SEARCHES=4
# WEBJEV_MAX_CLARIFICATIONS=2
# WEBJEV_MIN_ANSWER_CONFIDENCE=0.5
# WEBJEV_REVIEW_THRESHOLD=0.5
# WEBJEV_OFFLINE=1
